ex:SampleLPRBenchmark a bc:BenchmarkRate ;
    rdfs:label "示例 1 年期 LPR 参考利率"@zh, "Example 1Y LPR reference rate"@en ;
    skos:definition "公开通用的贷款市场报价利率（LPR）参考示例，仅用于演示基准利率概念。"@zh ;
    skos:definition "A public Loan Prime Rate (LPR) reference example, used only to demonstrate the benchmark-rate concept."@en ;
    skos:editorialNote "Public benchmark reference for the demo; not an institution-specific product or live market quote."@en ;
    bc:interestRate 3.45 .
