@prefix bc:  <https://ontology.example/banking-core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.example/banking-core>
    a owl:Ontology ;
    rdfs:label "Banking Core Ontology"@en, "银行核心概念本体"@zh ;
    rdfs:comment "Lightweight OWL ontology of banking business and product concepts, authored for the banking-concept-kb-mvp demo. Aligned to FIBO terminology by annotation only (see fibo-alignment.ttl)."@en ;
    owl:versionInfo "0.1.0-mvp" .

###############################################################################
# Top-level and domain classes
###############################################################################

bc:Product a owl:Class ;
    rdfs:label "产品"@zh, "Product"@en ;
    skos:definition "商业银行向客户提供的金融服务与产品的总称，包括存款、贷款、理财等。"@zh ;
    skos:definition "Banking products and services offered by commercial banks, including deposits, loans, wealth management and related offerings."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:Account a owl:Class ;
    rdfs:label "账户"@zh, "Account"@en ;
    skos:definition "银行为客户开立的、用于资金往来、核算与记录交易的账户的总称。"@zh ;
    skos:definition "An arrangement a bank maintains for a customer to record, hold and transact funds."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:Party a owl:Class ;
    rdfs:label "主体"@zh, "Party"@en ;
    skos:definition "参与银行业务或与之相关的法律主体，包括银行自身、零售客户与对公客户等。"@zh ;
    skos:definition "A legal or natural person involved in banking business, such as the bank itself, retail customers or corporate customers."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

###############################################################################
# Deposit hierarchy (存款 → 活期存款 / 定期存款 → 大额存单, 长期定期存款[演示])
###############################################################################

bc:Deposit a owl:Class ;
    rdfs:subClassOf bc:Product ;
    rdfs:label "存款"@zh, "Deposit"@en ;
    skos:altLabel "存款产品"@zh ;
    skos:definition "客户存放在银行的资金，银行按约定计息并可按约定支取。"@zh ;
    skos:definition "Money placed with a bank by a customer, on which the bank pays interest and which the customer may withdraw as agreed."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:DemandDeposit a owl:Class ;
    rdfs:subClassOf bc:Deposit ;
    rdfs:label "活期存款"@zh, "Demand Deposit"@en ;
    skos:altLabel "活期"@zh ;
    skos:definition "可以随时存入和支取、无固定期限的存款。"@zh ;
    skos:definition "A deposit that can be deposited and withdrawn at any time without a fixed term."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:TimeDeposit a owl:Class ;
    rdfs:subClassOf bc:Deposit ;
    rdfs:label "定期存款"@zh, "Time Deposit"@en ;
    skos:altLabel "定存"@zh ;
    skos:definition "事先约定存期、到期支取本息的存款，通常利率高于活期存款。"@zh ;
    skos:definition "A deposit with a pre-agreed term that pays principal and interest at maturity, usually at a higher rate than a demand deposit."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:CertificateOfDeposit a owl:Class ;
    rdfs:subClassOf bc:TimeDeposit ;
    rdfs:label "大额存单"@zh, "Certificate of Deposit"@en ;
    skos:altLabel "CD"@en, "大额可转让存单"@zh ;
    skos:definition "商业银行面向个人与企业发行的记账式大额存款凭证，属于一般性存款，期限与起存金额均有较高要求。"@zh ;
    skos:definition "A large-denomination deposit certificate issued by commercial banks to individuals and enterprises; it counts as ordinary deposit and typically carries a high minimum amount."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:LongTermTimeDeposit a owl:Class ;
    rdfs:subClassOf bc:TimeDeposit ;
    rdfs:label "长期定期存款（演示分类）"@zh, "Long-Term Time Deposit (demo classification)"@en ;
    skos:definition "演示用分类：由推理演示规则将存期不低于 60 个月的定期存款归入的类别，不代表银行实际产品分类。"@zh ;
    skos:definition "Demo-only classification produced by the reasoning-demo rule when a time deposit's term is at least 60 months; not a real bank product category."@en ;
    skos:editorialNote "Demo classification produced by rules.py; introduced solely to demonstrate rule-derived reasoning."@en .

###############################################################################
# Loan hierarchy (贷款 → 个人贷款 → 住房贷款 / 信用贷款)
###############################################################################

bc:Loan a owl:Class ;
    rdfs:subClassOf bc:Product ;
    rdfs:label "贷款"@zh, "Loan"@en ;
    skos:definition "银行将资金按约定利率贷放给借款人并在约定期限内收回本息的融资安排。"@zh ;
    skos:definition "An arrangement in which a bank lends funds to a borrower at an agreed rate, to be repaid with interest within an agreed term."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:PersonalLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "个人贷款"@zh, "Personal Loan"@en ;
    skos:definition "银行向个人客户发放的、用于消费或经营等用途的贷款。"@zh ;
    skos:definition "A loan extended by a bank to an individual customer for consumption, business or other personal purposes."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:HousingLoan a owl:Class ;
    rdfs:subClassOf bc:PersonalLoan ;
    rdfs:label "住房贷款"@zh, "Housing Loan"@en ;
    skos:altLabel "按揭贷款"@zh, "mortgage"@en ;
    skos:definition "用于购买自住或投资性房产的个人贷款，通常以所购房产设定抵押。"@zh ;
    skos:definition "A personal loan used to purchase residential property, typically secured by a mortgage over the purchased property."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:CreditLoan a owl:Class ;
    rdfs:subClassOf bc:PersonalLoan ;
    rdfs:label "信用贷款"@zh, "Credit Loan"@en ;
    skos:altLabel "无抵押贷款"@zh ;
    skos:definition "基于借款人信用而非抵押物发放的个人贷款，对信用评估要求较高。"@zh ;
    skos:definition "A personal loan granted on the borrower's creditworthiness rather than collateral, requiring a strong credit assessment."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

###############################################################################
# Wealth management (理财产品 → 现金管理类 / 固收类)
###############################################################################

bc:WealthManagementProduct a owl:Class ;
    rdfs:subClassOf bc:Product ;
    rdfs:label "理财产品"@zh, "Wealth Management Product"@en ;
    skos:altLabel "银行理财"@zh ;
    skos:definition "银行或其理财子公司发行、按约定投资运作并使投资者按约获得收益的资产管理产品。"@zh ;
    skos:definition "An asset-management product issued by a bank or its wealth-management subsidiary, invested per its terms to return earnings to investors as agreed."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:CashManagementProduct a owl:Class ;
    rdfs:subClassOf bc:WealthManagementProduct ;
    rdfs:label "现金管理类产品"@zh, "Cash Management Product"@en ;
    skos:definition "流动性高、风险低、近似货币基金的开放式理财产品。"@zh ;
    skos:definition "An open-ended wealth-management product with high liquidity and low risk, similar in character to a money-market fund."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:FixedIncomeWealthProduct a owl:Class ;
    rdfs:subClassOf bc:WealthManagementProduct ;
    rdfs:label "固收类理财产品"@zh, "Fixed-Income Wealth Management Product"@en ;
    skos:altLabel "固收类理财"@zh ;
    skos:definition "主要投资于债券等固定收益类资产的理财产品。"@zh ;
    skos:definition "A wealth-management product that invests mainly in fixed-income assets such as bonds."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

###############################################################################
# Account hierarchy (账户 → 储蓄账户 / 结算账户)
###############################################################################

bc:SavingsAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "储蓄账户"@zh, "Savings Account"@en ;
    skos:definition "以储蓄存款为目的开立的账户，用于管理客户的存款资金。"@zh ;
    skos:definition "An account opened for savings purposes, used to manage a customer's deposit funds."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:SettlementAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "结算账户"@zh, "Settlement Account"@en ;
    skos:altLabel "结算户"@zh, "current account"@en ;
    skos:definition "用于日常资金收付、转账与结算的银行账户，常见于对公客户。"@zh ;
    skos:definition "A bank account used for day-to-day receipts, payments, transfers and clearing, commonly held by corporate customers."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

###############################################################################
# Party hierarchy (主体 → 银行 / 零售客户 / 对公客户)
###############################################################################

bc:Bank a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "银行"@zh, "Bank"@en ;
    skos:definition "依法设立的、主要经营存贷款与支付结算等业务的金融机构。"@zh ;
    skos:definition "A financial institution duly established to conduct deposit-taking, lending and payment and settlement business."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:RetailCustomer a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "零售客户"@zh, "Retail Customer"@en ;
    skos:altLabel "个人客户"@zh ;
    skos:definition "以个人身份与银行发生业务往来的客户。"@zh ;
    skos:definition "A customer who deals with the bank in a personal capacity."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

bc:CorporateCustomer a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "对公客户"@zh, "Corporate Customer"@en ;
    skos:altLabel "企业客户"@zh ;
    skos:definition "以企业或机构身份与银行发生业务往来的客户。"@zh ;
    skos:definition "A customer who deals with the bank as a business or institution."@en ;
    skos:editorialNote "Public generic definition authored for the MVP demo; not internal bank documentation."@en .

###############################################################################
# Properties
###############################################################################

bc:offeredBy a owl:ObjectProperty ;
    rdfs:label "提供机构"@zh, "Offered by"@en ;
    rdfs:domain bc:Product ;
    rdfs:range bc:Party ;
    skos:definition "产品由哪一主体提供。"@zh ;
    skos:definition "The party that offers a product."@en .

bc:supportsProduct a owl:ObjectProperty ;
    rdfs:label "支持的产品"@zh, "Supports product"@en ;
    rdfs:domain bc:Account ;
    rdfs:range bc:Product ;
    skos:definition "账户可用于承载或关联的产品。"@zh ;
    skos:definition "A product that an account can host or be associated with."@en .

bc:termMonths a owl:DatatypeProperty ;
    rdfs:label "期限（月）"@zh, "Term (months)"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:integer ;
    skos:definition "产品或融资安排的期限，以月为单位。"@zh ;
    skos:definition "The term of a product or financing arrangement, in months."@en .

bc:minimumAmount a owl:DatatypeProperty ;
    rdfs:label "最低金额"@zh, "Minimum amount"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "购买或存入该产品所需的最低金额。"@zh ;
    skos:definition "The minimum amount required to purchase or deposit into a product."@en .

bc:interestRate a owl:DatatypeProperty ;
    rdfs:label "利率（%）"@zh, "Interest rate (%)"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "产品的利率，以百分比数值表示（如 1.45 表示 1.45%）。"@zh ;
    skos:definition "The interest rate of a product expressed as a percentage value (e.g. 1.45 means 1.45%)."@en .

bc:annualizedReturn a owl:DatatypeProperty ;
    rdfs:label "年化收益率（%）"@zh, "Annualized return (%)"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "理财产品按年折算的收益率，以百分比数值表示。"@zh ;
    skos:definition "The annualized return of a wealth-management product, as a percentage value."@en .

bc:riskLevel a owl:DatatypeProperty ;
    rdfs:label "风险等级"@zh, "Risk level"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:string ;
    skos:definition "产品的风险等级定性描述（低/中/高）。"@zh ;
    skos:definition "Qualitative risk level of a product (low/medium/high)."@en .

bc:liquidity a owl:DatatypeProperty ;
    rdfs:label "流动性"@zh, "Liquidity"@en ;
    rdfs:domain bc:Product ;
    rdfs:range xsd:string ;
    skos:definition "产品资金的流动便利程度（高/中/低）。"@zh ;
    skos:definition "How easily funds in a product can be accessed (high/medium/low)."@en .

bc:depositInsuranceCovered a owl:DatatypeProperty ;
    rdfs:label "存款保险保障"@zh, "Deposit-insurance covered"@en ;
    rdfs:domain bc:Deposit ;
    rdfs:range xsd:boolean ;
    skos:definition "该存款是否受存款保险制度保障。"@zh ;
    skos:definition "Whether the deposit is covered by the deposit-insurance scheme."@en .

###############################################################################
# Annotation properties
###############################################################################

bc:alignedToFibo a owl:AnnotationProperty ;
    rdfs:label "对齐至 FIBO 术语"@zh, "Aligned to FIBO term"@en ;
    skos:definition "声明本类与某个 FIBO（金融业业务本体）术语之间的术语对齐；仅为注释，不引入 FIBO 本体。"@zh ;
    skos:definition "Declares a terminology alignment between this class and a FIBO (Financial Industry Business Ontology) term; annotation only, never imports FIBO."@en .

###############################################################################
# Enrichment (ontology-enrichment): extra deposit arrangements
###############################################################################

bc:NotificationDeposit a owl:Class ;
    rdfs:subClassOf bc:Deposit ;
    rdfs:label "通知存款"@zh, "Notice Deposit"@en ;
    skos:definition "不约定存期、支取需提前通知银行并约定支取日期与金额的存款。"@zh ;
    skos:definition "A deposit with no fixed term that requires prior notice to the bank before withdrawal."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment); see docs/reference/ontology-sources.md."@en .

bc:NegotiatedDeposit a owl:Class ;
    rdfs:subClassOf bc:Deposit ;
    rdfs:label "协定存款"@zh, "Agreement Deposit"@en ;
    skos:definition "面向企业客户、与银行约定留存基本额度、超出部分按协定利率计息的存款安排。"@zh ;
    skos:definition "A corporate deposit arrangement in which amounts above an agreed base earn a negotiated rate."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:StructuredDeposit a owl:Class ;
    rdfs:subClassOf bc:Deposit ;
    rdfs:label "结构性存款"@zh, "Structured Deposit"@en ;
    skos:definition "嵌入利率/汇率/指数等衍生结构、收益浮动的存款产品；属于一般性存款并按规计息。"@zh ;
    skos:definition "A deposit product embedding a derivative structure whose return is linked to rates, FX or indices."@en ;
    skos:editorialNote "Public generic concept referencing a public regulatory classification, not an institution-specific product."@en .

###############################################################################
# Enrichment: loan classes (usage and security dimensions)
###############################################################################

bc:ConsumptionLoan a owl:Class ;
    rdfs:subClassOf bc:PersonalLoan ;
    rdfs:label "消费贷款"@zh, "Consumer Loan"@en ;
    skos:altLabel "消费贷"@zh ;
    skos:definition "用于个人消费用途（购车、装修、大额消费品等）的贷款。"@zh ;
    skos:definition "A personal loan for consumption purposes such as vehicles, renovation or durable goods."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:BusinessOperationLoan a owl:Class ;
    rdfs:subClassOf bc:PersonalLoan ;
    rdfs:label "经营贷款"@zh, "Personal Business Loan"@en ;
    skos:altLabel "经营贷"@zh ;
    skos:definition "向个体工商户或小微企业主发放的用于生产经营的贷款。"@zh ;
    skos:definition "A loan to self-employed individuals or small-business owners for business operations."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:AutoLoan a owl:Class ;
    rdfs:subClassOf bc:ConsumptionLoan ;
    rdfs:label "汽车贷款"@zh, "Auto Loan"@en ;
    skos:altLabel "车贷"@zh ;
    skos:definition "用于购买汽车并以所购车辆（或其他财产）担保的贷款。"@zh ;
    skos:definition "A loan used to purchase a vehicle, typically secured by the vehicle."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:WorkingCapitalLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "流动资金贷款"@zh, "Working Capital Loan"@en ;
    skos:definition "银行为满足企业日常生产经营周转需要而发放的贷款。"@zh ;
    skos:definition "A loan that finances an enterprise's day-to-day operating liquidity needs."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:FixedAssetLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "固定资产贷款"@zh, "Fixed Asset Loan"@en ;
    skos:definition "用于企业固定资产投资（购建、改造等）的中长期贷款。"@zh ;
    skos:definition "A medium/long-term loan financing an enterprise's fixed-asset investment."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:CollateralizedLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "抵押贷款"@zh, "Collateralized Loan"@en ;
    skos:definition "以借款人或第三人提供的抵押物（不动产等）担保的贷款（担保方式维度）。"@zh ;
    skos:definition "A loan secured by collateral such as real property (a security-dimension classification)."@en ;
    skos:editorialNote "Public generic concept; security-dimension view complementary to use-dimension classes."@en .

bc:PledgedLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "质押贷款"@zh, "Pledged Loan"@en ;
    skos:definition "以借款人或第三人移交占有的动产、权利凭证等质押担保的贷款。"@zh ;
    skos:definition "A loan secured by pledged movable assets or rights certificates."@en ;
    skos:editorialNote "Public generic concept; security-dimension view."@en .

bc:GuaranteedLoan a owl:Class ;
    rdfs:subClassOf bc:Loan ;
    rdfs:label "保证贷款"@zh, "Guaranteed Loan"@en ;
    skos:definition "由保证人按约承担连带/一般保证责任的贷款。"@zh ;
    skos:definition "A loan backed by a guarantor's obligation to repay if the borrower defaults."@en ;
    skos:editorialNote "Public generic concept; security-dimension view."@en .

###############################################################################
# Enrichment: wealth-management classification
###############################################################################

bc:HybridWealthProduct a owl:Class ;
    rdfs:subClassOf bc:WealthManagementProduct ;
    rdfs:label "混合类理财产品"@zh, "Hybrid Wealth Management Product"@en ;
    skos:altLabel "混合类理财"@zh ;
    skos:definition "按产品说明书同时投资于债权类与权益类等多种资产的理财产品。"@zh ;
    skos:definition "A wealth-management product investing in a mix of debt-type and equity-type assets per its prospectus."@en ;
    skos:editorialNote "Public generic classification concept; not an institution-specific product."@en .

bc:EquityWealthProduct a owl:Class ;
    rdfs:subClassOf bc:WealthManagementProduct ;
    rdfs:label "权益类理财产品"@zh, "Equity Wealth Management Product"@en ;
    skos:altLabel "权益类理财"@zh ;
    skos:definition "主要投资于股票等权益类资产的理财产品。"@zh ;
    skos:definition "A wealth-management product investing mainly in equity-type assets such as stocks."@en ;
    skos:editorialNote "Public generic classification concept; not an institution-specific product."@en .

###############################################################################
# Enrichment: account classes (incl. deposit/loan accounts and corporate accounts)
###############################################################################

bc:TimeDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "定期存款账户"@zh, "Time Deposit Account"@en ;
    skos:definition "用于记载定期存款资金与利息的账户。"@zh ;
    skos:definition "An account that records time-deposit funds and interest."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:DemandDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "活期存款账户"@zh, "Demand Deposit Account"@en ;
    skos:definition "可随时存取、用于日常资金往来的账户。"@zh ;
    skos:definition "An account that can be deposited into and withdrawn from at any time for day-to-day flows."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:LoanAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "贷款账户"@zh, "Loan Account"@en ;
    skos:definition "用于记载贷款发放、计息与偿还的账户。"@zh ;
    skos:definition "An account recording loan disbursement, interest and repayment."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:BasicDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "基本存款账户"@zh, "Basic Deposit Account"@en ;
    skos:altLabel "基本户"@zh ;
    skos:definition "单位客户因办理日常转账结算与现金收付开立的基本账户，每户只能开立一个。"@zh ;
    skos:definition "A corporate unit's primary account for daily settlement and cash receipt/payment; one per entity."@en ;
    skos:editorialNote "Public generic account concept from general settlement practice."@en .

bc:GeneralDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "一般存款账户"@zh, "General Deposit Account"@en ;
    skos:altLabel "一般户"@zh ;
    skos:definition "单位客户因借款或其他结算需要开立的辅助存款账户。"@zh ;
    skos:definition "A supplementary corporate account opened for borrowing or other settlement needs."@en ;
    skos:editorialNote "Public generic account concept from general settlement practice."@en .

bc:SpecialDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "专用存款账户"@zh, "Special-Purpose Deposit Account"@en ;
    skos:altLabel "专用户"@zh ;
    skos:definition "单位客户按规对特定用途资金（如专项资金）实行专项管理的账户。"@zh ;
    skos:definition "A corporate account managing funds earmarked for a specific purpose."@en ;
    skos:editorialNote "Public generic account concept from general settlement practice."@en .

bc:TemporaryDepositAccount a owl:Class ;
    rdfs:subClassOf bc:Account ;
    rdfs:label "临时存款账户"@zh, "Temporary Deposit Account"@en ;
    skos:altLabel "临时户"@zh ;
    skos:definition "单位客户因临时经营活动或异地临时需要而开立的账户，按规定期限使用。"@zh ;
    skos:definition "A corporate account opened for temporary or out-of-town business activity, valid for a limited period."@en ;
    skos:editorialNote "Public generic account concept from general settlement practice."@en .

###############################################################################
# Enrichment: party roles
###############################################################################

bc:FinancialInstitutionCustomer a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "金融机构客户"@zh, "Financial-Institution Customer"@en ;
    skos:altLabel "同业客户"@zh ;
    skos:definition "与银行开展同业往来的其他金融机构客户。"@zh ;
    skos:definition "A customer that is another financial institution dealing with the bank (interbank context)."@en ;
    skos:editorialNote "Public generic role concept."@en .

bc:Employee a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "员工"@zh, "Employee"@en ;
    skos:definition "银行的雇员主体（知识库使用方角色，用于演示语境）。"@zh ;
    skos:definition "An employee of the bank (the knowledge-base user role in this demo context)."@en ;
    skos:editorialNote "Demo context role; not an internal data record."@en .

bc:Borrower a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "借款人"@zh, "Borrower"@en ;
    skos:definition "从银行取得贷款并按约还本付息的债务人（角色视角）。"@zh ;
    skos:definition "A party that receives a loan and must repay principal and interest as agreed (role view)."@en ;
    skos:editorialNote "Public generic role concept."@en .

bc:Lender a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "贷款人"@zh, "Lender"@en ;
    skos:definition "按约向借款人融出资金的债权人，通常是银行（角色视角）。"@zh ;
    skos:definition "A party that lends funds to a borrower under agreed terms, typically the bank (role view)."@en ;
    skos:editorialNote "Public generic role concept."@en .

bc:Depositor a owl:Class ;
    rdfs:subClassOf bc:Party ;
    rdfs:label "存款人"@zh, "Depositor"@en ;
    skos:definition "在银行存款并享有相应权益的主体（角色视角）。"@zh ;
    skos:definition "A party that places funds on deposit with a bank and holds the corresponding rights (role view)."@en ;
    skos:editorialNote "Public generic role concept."@en .

###############################################################################
# Enrichment: rate & pricing concepts
###############################################################################

bc:Rate a owl:Class ;
    rdfs:label "利率"@zh, "Rate"@en ;
    skos:definition "资金使用价格，即一定时期内利息额与本金的比率，通常以年化百分比表示。"@zh ;
    skos:definition "The price of money — interest over a period divided by principal, usually annualized as a percentage."@en ;
    skos:editorialNote "Public generic concept aligned per FIBO review (ontology-enrichment)."@en .

bc:FixedRate a owl:Class ;
    rdfs:subClassOf bc:Rate ;
    rdfs:label "固定利率"@zh, "Fixed Rate"@en ;
    skos:definition "存续期内不随市场变化的利率。"@zh ;
    skos:definition "A rate that stays constant over the term regardless of market movements."@en ;
    skos:editorialNote "Public generic concept."@en .

bc:FloatingRate a owl:Class ;
    rdfs:subClassOf bc:Rate ;
    rdfs:label "浮动利率"@zh, "Floating Rate"@en ;
    skos:definition "按约定参考基准并随其定期调整的利率。"@zh ;
    skos:definition "A rate that adjusts periodically against an agreed reference benchmark."@en ;
    skos:editorialNote "Public generic concept."@en .

bc:BenchmarkRate a owl:Class ;
    rdfs:subClassOf bc:Rate ;
    rdfs:label "基准利率"@zh, "Benchmark Rate"@en ;
    skos:definition "被市场或产品作为定价参考的公开利率，例如贷款市场报价利率（LPR）等。"@zh ;
    skos:definition "A published rate used as a pricing reference, such as a Loan Prime Rate (LPR)."@en ;
    skos:editorialNote "Public generic concept; LPR appears only as a public benchmark reference, not an institution-specific product."@en .

###############################################################################
# Enrichment: banking event concepts
###############################################################################

bc:BankingEvent a owl:Class ;
    rdfs:label "银行事件"@zh, "Banking Event"@en ;
    skos:definition "与账户或产品存续相关的银行事件类型的总称。"@zh ;
    skos:definition "A general category of banking events related to accounts or product lifecycles."@en ;
    skos:editorialNote "Public generic event taxonomy; no internal or case-specific events."@en .

bc:AccountEvent a owl:Class ;
    rdfs:subClassOf bc:BankingEvent ;
    rdfs:label "账户事件"@zh, "Account Event"@en ;
    skos:definition "发生在账户层面的事件类型。"@zh ;
    skos:definition "An event type that occurs at the account level."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:AccountOpeningEvent a owl:Class ;
    rdfs:subClassOf bc:AccountEvent ;
    rdfs:label "开户事件"@zh, "Account Opening Event"@en ;
    skos:definition "开立账户的事件。"@zh ;
    skos:definition "The event of opening an account."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:AccountClosingEvent a owl:Class ;
    rdfs:subClassOf bc:AccountEvent ;
    rdfs:label "销户事件"@zh, "Account Closing Event"@en ;
    skos:definition "结清并注销账户的事件。"@zh ;
    skos:definition "The event of settling and closing an account."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:DepositWithdrawalEvent a owl:Class ;
    rdfs:subClassOf bc:AccountEvent ;
    rdfs:label "存取款事件"@zh, "Deposit/Withdrawal Event"@en ;
    skos:definition "账户资金存入或支取的事件。"@zh ;
    skos:definition "An event of depositing funds into or withdrawing funds from an account."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:TransferEvent a owl:Class ;
    rdfs:subClassOf bc:AccountEvent ;
    rdfs:label "转账事件"@zh, "Transfer Event"@en ;
    skos:definition "资金在账户之间划转的事件。"@zh ;
    skos:definition "An event of moving funds between accounts."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:InterestSettlementEvent a owl:Class ;
    rdfs:subClassOf bc:AccountEvent ;
    rdfs:label "结息事件"@zh, "Interest Settlement Event"@en ;
    skos:definition "按约定周期计算并支付利息的事件。"@zh ;
    skos:definition "The event of computing and paying interest on a periodic basis."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:ProductLifecycleEvent a owl:Class ;
    rdfs:subClassOf bc:BankingEvent ;
    rdfs:label "产品生命周期事件"@zh, "Product Lifecycle Event"@en ;
    skos:definition "发生在产品/融资安排存续阶段的事件类型。"@zh ;
    skos:definition "An event type that occurs during a product's or financing arrangement's lifecycle."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:MaturityEvent a owl:Class ;
    rdfs:subClassOf bc:ProductLifecycleEvent ;
    rdfs:label "到期事件"@zh, "Maturity Event"@en ;
    skos:definition "产品到期兑付或到期处理的事件。"@zh ;
    skos:definition "The event of a product reaching maturity and being paid out or handled."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:EarlyWithdrawalEvent a owl:Class ;
    rdfs:subClassOf bc:ProductLifecycleEvent ;
    rdfs:label "提前支取事件"@zh, "Early Withdrawal Event"@en ;
    skos:definition "未到期提前支取存款（通常按活期或约定规则计息）的事件。"@zh ;
    skos:definition "The event of withdrawing a deposit before maturity (interest per rules or at demand rate)."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .

bc:RolloverEvent a owl:Class ;
    rdfs:subClassOf bc:ProductLifecycleEvent ;
    rdfs:label "展期事件"@zh, "Rollover Event"@en ;
    skos:altLabel "自动转存"@zh ;
    skos:definition "到期后续存/展期或自动转存的事件。"@zh ;
    skos:definition "The event of renewing or rolling over a product at maturity."@en ;
    skos:editorialNote "Public generic event taxonomy."@en .
