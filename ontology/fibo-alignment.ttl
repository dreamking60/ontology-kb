bc:DemandDeposit
    bc:alignedToFibo <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/FinancialProductsAndServices/Deposit> .

bc:TimeDeposit
    bc:alignedToFibo <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/FinancialProductsAndServices/Deposit> .

bc:CertificateOfDeposit
    bc:alignedToFibo <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/FinancialProductsAndServices/Deposit> .

bc:Loan
    bc:alignedToFibo <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/FinancialProductsAndServices/Loan> .

bc:HousingLoan
    bc:alignedToFibo <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/FinancialProductsAndServices/Loan> .
